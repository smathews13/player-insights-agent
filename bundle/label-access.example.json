{
  "catalog": "<production catalog>",
  "shared_schemas": ["<shared schema every label reads>"],
  "central_groups": ["<group that reads every label>"],
  "group_check": "is_account_group_member",
  "labels": [
    { "label": "<value in the master table's label column>", "group": "<label A data group>", "schemas": ["<label A schema>"] },
    { "label": "<value in the master table's label column>", "group": "<label B data group>", "schemas": ["<label B schema>"] }
  ],
  "master_tables": [
    {
      "table": "<catalog>.<schema>.<cross-label master table>",
      "label_column": "<column holding the label>",
      "readers": "central"
    }
  ]
}
