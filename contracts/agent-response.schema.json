      "type": "object"
    },
    "AnswerOutput": {
      "properties": {
        "answer": {
          "$ref": "#/$defs/AnswerContract"
        },
        "type": {
          "const": "answer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "answer"
      ],
      "title": "AnswerOutput",
      "type": "object"
    },
    "Chart": {
      "description": "One Plotly panel, as produced by `charts.new_plot`.\n\n`data` and `layout` are Plotly's own free-form shapes, carried opaquely to the\nbrowser. Only the envelope is a contract, and `kind` is derived from the\ntraces rather than supplied, so it cannot disagree with `data`.",
      "properties": {
        "data": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Data",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "layout": {
          "additionalProperties": true,
          "title": "Layout",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "data",
        "layout"
      ],
      "title": "Chart",
      "type": "object"
    },
    "Clarification": {
      "description": "The run stopped to ask the user something, rather than guessing.\n\nThe third outcome of a turn, alongside a plan and an answer. Used for a table\nnamed but not fully qualified, and for a question whose terms are undefined,\nwhere any interpretation produces a real number for a question nobody asked.\n\nDeliberately NOT an answer with a caveat: an answer invites the reader to use\nthe figures, and there are none worth using here.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceSummary"
        }
      },
      "required": [
        "id",
        "question",
        "reason",
        "options",
        "trace"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "ClarificationOutput": {
      "properties": {
        "clarification": {
          "$ref": "#/$defs/Clarification"
        },
        "type": {
          "const": "clarification",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "clarification"
      ],
      "title": "ClarificationOutput",
      "type": "object"
    },
    "DashboardOutput": {
      "description": "A backend-authored renderable artifact.\n\nThe backend selects the declared format and owns the payload. The frontend\nchooses only the matching generic rendering surface; it does not infer a\nformat, derive dashboard components, or reinterpret the payload as its own\nanswer/report contract.",
      "properties": {
        "renderable": {
          "description": "Backend-selected renderable payload. HTML is passed byte-for-byte to an isolated browser frame. JSON preserves the backend value and is displayed as JSON rather than rebuilt as frontend components.",
          "discriminator": {
            "mapping": {
              "html": "#/$defs/HtmlRenderable",
              "json": "#/$defs/JsonRenderable"
            },
            "propertyName": "format"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HtmlRenderable"
            },
            {
              "$ref": "#/$defs/JsonRenderable"
            }
          ],
          "title": "Renderable"
        },
        "type": {
          "const": "dashboard",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "renderable"
      ],
      "title": "DashboardOutput",
      "type": "object"
    },
    "Derivation": {
      "description": "What one statement measured, over what, from where.\n\nFour labelled facts, each derived from the parse of the statement that ran\n(`provenance.py`), never from what the model wrote. Together they answer the\nquestion a table name and a figure cannot: \"8,413 active players\" means one\nthing over thirty days and another over a year, and something different again\nwith one title filtered out.\n\nEVERY FIELD MAY BE EMPTY, and empty means the statement did not say. A query\nwith no WHERE clause covers everything and has no window, which is a fact\nabout it; a Genie statement whose tables could not be resolved has no source.\nA reader must render an empty field as nothing rather than as \"unknown\" or as\n\"all time\" -- the second is a claim about the population that nothing here\nchecked.\n\n`filter` never carries the VALUE of a column that identifies a person; the\ncolumn is named and the literal is withheld. See `provenance.py`, which does\nthe withholding, for why the column name itself is published.",
      "properties": {
        "filter": {
          "default": "",
          "title": "Filter",
          "type": "string"
        },
        "metric": {
          "default": "",
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "window": {
          "default": "",
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "source",
        "metric",
        "window",
        "filter"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DocumentSnippet": {
      "description": "A short, verbatim footnote from an attached document used in the answer.",
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "supports": {
          "title": "Supports",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "quote",
        "supports"
      ],
      "title": "DocumentSnippet",
      "type": "object"
    },
    "ExecutionIdentityClaim": {
      "properties": {
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "verified"
      ],
      "title": "ExecutionIdentityClaim",
      "type": "object"
    },
    "Figure": {
      "properties": {
        "comparison": {
          "default": "",
          "title": "Comparison",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "display",
        "comparison"
      ],
      "title": "Figure",
      "type": "object"
    },
    "GenieSpace": {
      "description": "A Genie space this run put a question to.\n\nRecorded per run because the space is chosen at request time from settings\nbaked into the model artifact, so it is a fact only the run itself knows: the\napp cannot read the orchestrator's configuration, and a deployment can be\nre-logged against different spaces without the app noticing. Without this,\nnothing anywhere records which space answered a given question.\n\nBoth halves, because they answer different questions. `id` is what an admin\nneeds to open the space or match it against the bundle; `title` is what a\nreader should be shown, since a 32-character hex id names infrastructure and\ntells a person nothing. `title` is empty when no title was baked at log time,\nand a reader with an empty title has to fall back rather than print a blank.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "GenieSpace",
      "type": "object"
    },
    "HtmlRenderable": {
      "description": "A complete backend-authored HTML document.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "format": {
          "const": "html",
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "format",
        "content"
      ],
      "title": "HtmlRenderable",
      "type": "object"
    },
    "JsonRenderable": {
      "description": "Backend-authored JSON whose structure remains backend-owned.",
      "properties": {
        "content": {
          "title": "Content"
        },
        "format": {
          "const": "json",
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "format",
        "content"
      ],
      "title": "JsonRenderable",
      "type": "object"
    },
