{
  "$defs": {
    "AnalysisPlan": {
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/PlanCandidate"
          },
          "maxItems": 3,
          "title": "Candidates",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "requires_approval": {
          "default": true,
          "title": "Requires Approval",
          "type": "boolean"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "uses_attachment_context": {
          "default": false,
          "title": "Uses Attachment Context",
          "type": "boolean"
        },
        "uses_conversation_context": {
          "default": false,
          "title": "Uses Conversation Context",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question",
        "summary",
        "steps",
        "candidates",
        "requires_approval",
        "uses_conversation_context",
        "uses_attachment_context"
      ],
      "title": "AnalysisPlan",
      "type": "object"
    },
    "AnswerContract": {
      "properties": {
        "caveats": {
          "description": "Reader-facing qualifications. This is intentionally an open list of strings: live table names, dates, metric names and access decisions make the sentence set dynamic. See x-pia-caveats in the generated shared schema for the closed semantic families, stable markers and ordering rules.",
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "chart_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Chart Evidence",
          "type": "array"
        },
        "charts": {
          "items": {
            "$ref": "#/$defs/Chart"
          },
          "title": "Charts",
          "type": "array"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "derivation": {
          "items": {
            "$ref": "#/$defs/Derivation"
          },
          "title": "Derivation",
          "type": "array"
        },
        "document_snippets": {
          "items": {
            "$ref": "#/$defs/DocumentSnippet"
          },
          "title": "Document Snippets",
          "type": "array"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Figures",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "narrative": {
          "title": "Narrative",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "sql": {
          "default": "",
          "title": "Sql",
          "type": "string"
        },
        "takeaway": {
          "title": "Takeaway",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceSummary"
        }
      },
      "required": [
        "id",
        "takeaway",
        "narrative",
        "content",
        "figures",
        "charts",
        "chart_evidence",
        "sources",
        "document_snippets",
        "caveats",
        "derivation",
        "sql",
        "trace"
      ],
