{
  "name": "player-insights-agent",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client:deploy": "vite build --config client/vite.config.ts && npm run check:client-css",
    "build:client": "npm run typecheck && npm run build:client:deploy",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "bundle:deploy": "node scripts/bundle-server.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "smoke:deploy-artifact": "node scripts/smoke-deploy-artifact.mjs",
    "check:deploy-artifact": "node scripts/check-deploy-artifact.mjs",
    "build:deploy": "npm run build:client:deploy && npm run bundle:deploy && npm run check:deploy-artifact",
    "migrate:lakebase": "tsx --tsconfig ./tsconfig.server.json scripts/migrate-lakebase.mts",
    "deploy": "../bundle/app-release.sh --apply",
    "deploy:rollback": "../bundle/app-release.sh --apply --rollback-to",
    "typecheck": "tsc -b tsconfig.server.json tsconfig.client.json tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "check:client-css": "node scripts/check-client-css-manifest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf client/dist dist build node_modules .smoke-test test-results playwright-report",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Player Insights Agent with governed analytics, traces, and repeatable benchmarking",
  "dependencies": {
    "@databricks/appkit": "0.38.1",
    "@databricks/appkit-ui": "0.38.1",
    "@databricks/sdk-experimental": "0.17.0",
    "clsx": "2.1.1",
    "express": "4.22.2",
    "lucide-react": "0.554.0",
    "plotly.js-cartesian-dist-min": "^3.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.2",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "pg": "8.18.0",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
